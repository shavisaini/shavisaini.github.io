---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { nav } from '../site.config';
import { href } from '../lib/url';
---

<BaseLayout title="Page not found" description="That page does not exist on this site." page="not-found">
  <div class="page page--narrow not-found" data-reveal>
    <p class="eyebrow">404</p>
    <h1>That page does not exist</h1>
    <p class="lede">Nothing is here. These pages are:</p>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={href(item.path)}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <ButtonLink href={href('/')} variant="solid">Back to the start</ButtonLink>
  </div>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: var(--space-9);
  }

  .not-found::before {
    content: '404';
    position: absolute;
    top: 0.2rem;
    left: 0;
    font-size: clamp(6rem, 22vw, 11rem);
    font-weight: 560;
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: var(--text);
    opacity: 0.045;
    pointer-events: none;
    z-index: 0;
  }

  .not-found > * {
    position: relative;
    z-index: 1;
  }

  .not-found ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
  }
</style>
