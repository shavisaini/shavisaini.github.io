---
/**
 * One dialog per page, shared by every `Figure`. Without JavaScript each figure
 * stays an ordinary link to the full-size image, so nothing is lost.
 */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Screenshot, full size">
  <button class="lightbox__close" type="button" data-lightbox-close>
    <span aria-hidden="true">×</span>
    <span class="visually-hidden">Close</span>
  </button>
  <div class="lightbox__viewport">
    <!-- No `src` until a figure is opened: an empty one would refetch the page. -->
    <img data-lightbox-image alt="" />
  </div>
  <p class="lightbox__hint">Drag to pan</p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const close = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]');

  if (dialog && image) {
    let opener: HTMLAnchorElement | null = null;

    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        opener = trigger;
        image.src = trigger.href;
        image.alt = trigger.dataset.alt ?? '';
        dialog.showModal();
      });
    });

    close?.addEventListener('click', () => dialog.close());

    // Clicking the backdrop (anywhere that is not the image) dismisses it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      image.removeAttribute('src');
      opener?.focus();
      opener = null;
    });
  }
</script>

<style>
  .lightbox {
    width: min(96vw, 1800px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    color: var(--text);
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(5 7 9 / 0.82);
    backdrop-filter: blur(3px);
  }

  .lightbox__viewport {
    border-radius: inherit;
    overflow: hidden;
  }

  .lightbox img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 94vh;
    object-fit: contain;
  }

  .lightbox__close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg-raised);
    color: var(--text-muted);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox__close:hover {
    color: var(--text);
  }

  .lightbox__hint {
    display: none;
  }

  /*
   * A dashboard capture scaled to phone width is unreadable, so below this
   * breakpoint the image keeps a legible intrinsic size and the viewport pans.
   */
  @media (max-width: 52rem) {
    .lightbox {
      width: 100vw;
      max-height: 100vh;
      border-radius: 0;
      border: 0;
    }

    .lightbox__viewport {
      overflow: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      max-height: 100vh;
    }

    .lightbox img {
      width: auto;
      max-width: none;
      max-height: none;
      min-width: min(1100px, 260vw);
    }

    .lightbox__close {
      position: fixed;
      top: 0.75rem;
      right: 0.75rem;
    }

    .lightbox__hint {
      position: fixed;
      bottom: 0.9rem;
      left: 50%;
      transform: translateX(-50%);
      margin: 0;
      padding: 0.3rem 0.7rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg-raised) 92%, transparent);
      color: var(--text-faint);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.06em;
      display: block;
    }
  }
</style>
